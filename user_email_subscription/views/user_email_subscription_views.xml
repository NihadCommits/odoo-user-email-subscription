<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One list for both smart buttons: same toggles, same bulk actions on both sides. -->
    <record id="user_email_subscription_view_list" model="ir.ui.view">
        <field name="name">user.email.subscription.list</field>
        <field name="model">user.email.subscription</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <header>
                    <button name="action_subscribe" type="object" string="Subscribe"/>
                    <button name="action_unsubscribe" type="object" string="Unsubscribe"/>
                </header>
                <field name="user_id"/>
                <field name="template_id"/>
                <field name="is_subscribed" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="user_email_subscription_view_search" model="ir.ui.view">
        <field name="name">user.email.subscription.search</field>
        <field name="model">user.email.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="template_id"/>
                <filter name="unsubscribed" string="Unsubscribed" domain="[('is_subscribed', '=', False)]"/>
                <filter name="subscribed" string="Subscribed" domain="[('is_subscribed', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Opened by the smart buttons; they pass the user/template filter via context. -->
    <record id="action_user_email_subscription" model="ir.actions.act_window">
        <field name="name">Email Subscriptions</field>
        <field name="res_model">user.email.subscription</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
