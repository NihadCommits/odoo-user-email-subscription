<?xml version="1.0" encoding="utf-8"?>
<!-- Demo data (loaded only in databases with demo data): ready-made opt-out scenarios. -->
<odoo>
    <!-- Scenario 1, direct sending (Hook A): a weekly report to every internal user. -->
    <record id="mail_template_weekly_report" model="mail.template">
        <field name="name">Weekly Report</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">Your weekly report</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.name"/>,</p>
                <p>here is your weekly report.</p>
            </div>
        </field>
        <field name="is_user_subscribable" eval="True"/>
    </record>

    <!-- Run it with "Run Manually" (Settings > Technical > Scheduled Actions). -->
    <record id="ir_cron_weekly_report" model="ir.cron">
        <field name="name">Demo: Send Weekly Report</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">env.ref('user_email_subscription.mail_template_weekly_report').send_mail_batch(model.search([('share', '=', False)]).ids, force_send=True)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d 08:00:00')"/>
    </record>

    <!-- Scenario 2, chatter (Hook B): posted on a contact, reaches its followers. -->
    <record id="mail_template_contact_update" model="mail.template">
        <field name="name">Contact Update</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Update on {{ object.name }}</field>
        <field name="use_default_to" eval="False"/>  <!-- followers only, not the contact itself -->
        <field name="body_html" type="html">
            <div>
                <p>There is news about <t t-out="object.name"/>.</p>
            </div>
        </field>
        <field name="is_user_subscribable" eval="True"/>
    </record>

    <!-- Marc Demo follows the contact "Azure Interior" (subtype "Discussions"). -->
    <record id="follower_demo_azure_interior" model="mail.followers">
        <field name="res_model">res.partner</field>
        <field name="res_id" ref="base.res_partner_12"/>
        <field name="partner_id" ref="base.partner_demo"/>
        <field name="subtype_ids" eval="[Command.link(ref('mail.mt_comment'))]"/>
    </record>
</odoo>
